# Placeholder — never commit real secrets. Copy to .env and fill in.
# NEXUS_DATA_DIR=./data

# Which provider to use by default: mock | openai | ollama | custom
# NEXUS_PROVIDER=mock

# Set to 1 to refuse all cloud providers (local-only mode).
# NEXUS_OFFLINE_ONLY=0

# OpenAI-compatible provider settings (OpenAI, gateways, llama.cpp server, Ollama)
# NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
# NEXUS_OPENAI_MODEL=gpt-4o-mini
# NEXUS_OPENAI_API_KEY=

# Ollama (local)
# NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# NEXUS_OLLAMA_MODEL=llama3.1

# Planner + provider tuning
# NEXUS_REQUEST_TIMEOUT_S=60
# NEXUS_MAX_RETRIES=2
# NEXUS_MAX_ITERATIONS=12
# NEXUS_TASK_TIMEOUT_S=300
# NEXUS_TOOL_TIMEOUT_S=60

# Tool sandbox: colon-separated roots the agent may touch; comma-separated commands.
# NEXUS_APPROVED_ROOTS=
# NEXUS_ALLOWED_COMMANDS=ls,dir,echo,python,python3,pytest,git

# Agent service bind address (always loopback; never expose unauthenticated)
# NEXUS_HOST=127.0.0.1
# NEXUS_PORT=8765

# Voice engines: mock (default) or real backends
# NEXUS_STT=mock            # or: whisper  (needs NEXUS_WHISPER_URL)
# NEXUS_WHISPER_URL=http://127.0.0.1:8000
# NEXUS_WHISPER_MODEL=whisper-1
# NEXUS_WHISPER_API_KEY=
# NEXUS_TTS=mock            # or: command (needs NEXUS_TTS_COMMAND)
# NEXUS_TTS_COMMAND=espeak-ng --stdout -v en
# NEXUS_PLAYER_COMMAND=     # e.g. aplay (Linux), afplay (macOS); empty = mock

# Semantic memory embeddings: mock (default, offline), openai, or none
# NEXUS_EMBEDDINGS=mock
# NEXUS_EMBEDDINGS_URL=https://api.openai.com/v1
# NEXUS_EMBEDDINGS_MODEL=text-embedding-3-small
# NEXUS_EMBEDDINGS_API_KEY=

# Computer control backends: mock (default, safe) or real operators' commands
# NEXUS_SCREEN=mock            # or: command (needs NEXUS_SCREENCAP_COMMAND)
# NEXUS_SCREENCAP_COMMAND=     # e.g. "screencapture -x -t png -" (macOS), "grim -" (Wayland)
# NEXUS_OCR=mock               # or: tesseract (needs tesseract-ocr installed)
# NEXUS_ALLOWED_APPS=          # e.g. "notepad=notepad.exe;browser=firefox" (semicolon-separated name=command)
